{
  "name": "tsdm-framework-comparison-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4177 --strictPort",
    "test:e2e": "playwright test",
    "build:vue": "vite build --mode vue",
    "build:react": "vite build --mode react",
    "build": "npm run build:vue && npm run build:react",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit",
    "format": "prettier --write src probes scripts *.ts *.json index.html PLAN.md README.md",
    "receipt": "node scripts/receipt.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-vue": "6.0.10",
    "prettier": "3.9.10",
    "prosemirror-commands": "1.7.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.11",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.10.5",
    "prosemirror-view": "1.42.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "reka-ui": "2.11.0",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-monkey": "8.1.1",
    "vue": "3.5.44",
    "vue-tsc": "3.3.13"
  }
}
