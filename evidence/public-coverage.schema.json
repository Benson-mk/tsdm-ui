{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Benson-mk/tsdm-ui/evidence/public-coverage.schema.json",
  "title": "Public Coverage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requirements"],
  "properties": {
    "schema": {
      "const": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "cases", "gap", "requiredLevels"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["passed", "failed", "blocked", "not-run", "inconclusive"]
          },
          "cases": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "gap": {
            "type": "string"
          },
          "requiredLevels": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": ["synthetic", "live", "installed", "clean-node-consumer"]
            }
          }
        }
      }
    }
  }
}
